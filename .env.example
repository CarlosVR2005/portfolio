# Clave de API de Resend (https://resend.com/api-keys). Necesaria para el formulario de contacto.
RESEND_API_KEY=

# Remitente verificado en Resend. Mientras no verifiques un dominio propio puedes usar el de pruebas:
#   "Portfolio <onboarding@resend.dev>"  (solo puede enviar al email de tu cuenta de Resend)
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# Destinatario de los mensajes del formulario
CONTACT_TO=carlosvirigol@gmail.com

# Analítica sin cookies de Vercel: "true" para activarla
PUBLIC_ENABLE_ANALYTICS=false
