---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/i18n/ui';
const es = ui.es;
const en = ui.en;
---
<BaseLayout lang="es" title="404">
  <section class="relative isolate grid min-h-[85dvh] place-items-center overflow-hidden pt-28 pb-16">
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x text-center">
      <p class="font-display text-[clamp(7rem,30vw,16rem)] leading-none font-extrabold tracking-[-0.06em]" aria-hidden="true">
        4<span class="inline-block -rotate-6 rounded-3xl border-[3px] border-line bg-ocean px-3 text-[#16120f] shadow-[8px_8px_0_0_var(--shadow)]">0</span>4
      </p>
      <h1 class="mt-8 text-3xl font-extrabold md:text-5xl">{es['404.title']}</h1>
      <p class="mt-3 text-lg text-muted">{es['404.text']}</p>
      <p lang="en" class="mt-6 font-mono text-sm text-muted">{en['404.title']}. {en['404.text']}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary"><Icon name="arrowLeft" size={18} /> {es['404.back']}</a>
        <a href="/en/" lang="en" class="btn btn-ghost">{en['404.back']}</a>
      </div>
    </div>
  </section>
</BaseLayout>
