---
import type { Lang } from '@/i18n/ui';
import { useTranslations, pick } from '@/i18n/utils';
import { degrees, gradeHighlights, spokenLanguages, certificates } from '@/data/education';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const id = lang === 'es' ? 'formacion' : 'education';
---
<section id={id} class="section pt-8 md:pt-12" aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <SectionHeading id={`${id}-title`} kicker={t('edu.kicker')} title={t('edu.title')} />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-6">
        {
          degrees.map((d, i) => (
            <article class:list={['brut relative p-6 md:p-7', d.current && '!bg-[#16120f] text-[#f3e9d6] dark:!bg-surface-2 dark:text-ink']} data-reveal style={`--d:${i * 90}ms`}>
              <div class="flex flex-wrap items-start justify-between gap-3">
                <span class:list={['grid size-12 place-items-center rounded-xl border-2', d.current ? 'border-[#f3e9d6] bg-[#ff6a3d] text-[#16120f] dark:border-line' : 'border-line bg-[#4fc3e0] text-[#16120f]']}>
                  <Icon name={d.current ? 'graduation' : 'book'} size={24} />
                </span>
                <span class:list={['font-mono text-sm', d.current ? 'text-[#ffc53d]' : 'text-muted']}>{pick(d.dates, lang)}</span>
              </div>
              <h3 class="mt-4 font-display text-2xl font-extrabold md:text-3xl">{pick(d.title, lang)}</h3>
              <p class:list={['mt-1 font-medium', d.current ? 'text-[#f3e9d6]/80 dark:text-muted' : 'text-muted']}>{pick(d.school, lang)}</p>
              {d.note && <p class:list={['mt-4 leading-snug', d.current ? 'text-[#f3e9d6]/90 dark:text-ink' : '']}>{pick(d.note, lang)}</p>}
            </article>
          ))
        }
      </div>

      <div class="space-y-6">
        <article class="brut p-6" data-reveal style="--d:120ms">
          <h3 class="flex items-center gap-2 font-display text-xl font-bold"><Icon name="award" class="text-lava-ink" /> {t('edu.highlights')}</h3>
          <ul class="mt-4 space-y-3">
            {
              gradeHighlights.map((g) => (
                <li class="flex items-center justify-between gap-3 rounded-xl border-2 border-line bg-bg px-4 py-3">
                  <span class="font-medium leading-tight">{pick(g.subject, lang)}</span>
                  <span class="shrink-0 rotate-2 rounded-md border-2 border-[#16120f] bg-[#ffc53d] px-2 py-0.5 font-mono text-xs font-semibold text-[#16120f]">{pick(g.grade, lang)}</span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="brut p-6" data-reveal style="--d:180ms">
          <h3 class="flex items-center gap-2 font-display text-xl font-bold"><Icon name="globe" class="text-ocean-ink" /> {t('edu.languages')}</h3>
          <ul class="mt-4 space-y-2">
            {spokenLanguages.map((l) => (
              <li class="flex flex-wrap justify-between gap-2"><span class="font-semibold">{pick(l.name, lang)}</span><span class="text-muted">{pick(l.level, lang)}</span></li>
            ))}
          </ul>
          <h3 class="mt-6 flex items-center gap-2 font-display text-xl font-bold"><Icon name="sparkle" class="text-lava-ink" /> {t('edu.certs')}</h3>
          <ul class="mt-4 space-y-2">
            {certificates.map((c) => (
              <li class="flex flex-wrap justify-between gap-2"><span class="font-semibold">{pick(c.name, lang)}</span><span class="text-muted">{pick(c.issuer, lang)}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>
