---
import { Picture } from 'astro:assets';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import photo from '@/assets/carlos.jpg';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const id = lang === 'es' ? 'sobre-mi' : 'about';
const chips = [
  { icon: 'graduation', text: t('about.chip.uni') },
  { icon: 'mapPin', text: t('about.chip.city') },
  { icon: 'globe', text: t('about.chip.english') },
  { icon: 'award', text: t('about.chip.gpa') },
  { icon: 'calendar', text: t('about.chip.available') },
] as const;
const offcode = [
  { icon: 'waves', title: t('about.offcode.swim.title'), text: t('about.offcode.swim.text'), color: 'bg-[#4fc3e0]' },
  { icon: 'shirt', title: t('about.offcode.brand.title'), text: t('about.offcode.brand.text'), color: 'bg-[#ff6a3d]' },
  { icon: 'megaphone', title: t('about.offcode.events.title'), text: t('about.offcode.events.text'), color: 'bg-[#ffc53d]' },
] as const;
---
<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <SectionHeading id={`${id}-title`} kicker={t('about.kicker')} title={t('about.title')} />

    <div class="mt-12 grid items-start gap-12 md:grid-cols-[minmax(0,320px)_1fr] lg:gap-16">
      <!-- Foto -->
      <div class="relative mx-auto w-full max-w-[300px] md:max-w-[320px]" data-reveal="scale">
        <div class="photo-blob relative aspect-[415/489] overflow-hidden border-[3px] border-line bg-surface-2 shadow-[8px_8px_0_0_var(--shadow)]" data-tilt>
          <Picture
            src={photo}
            alt={t('about.photoAlt')}
            widths={[300, 415]}
            sizes="(min-width: 768px) 320px, 300px"
            formats={['avif', 'webp']}
            class="size-full object-cover"
            pictureAttributes={{ class: "block size-full" }}
            loading="lazy"
          />
        </div>
        <span class="absolute -right-3 -bottom-4 rotate-[-5deg] rounded-lg border-2 border-line bg-sulfur px-3 py-1 font-mono text-xs font-semibold text-[#16120f] shadow-[3px_3px_0_0_var(--shadow)]">
          📍 Lanzarote → Madrid
        </span>
      </div>

      <div>
        <div class="space-y-5 text-lg md:text-xl md:leading-relaxed" data-reveal>
          <p>{t('about.p1')}</p>
          <p class="text-muted">{t('about.p2')}</p>
        </div>

        <h3 class="sr-only">{t('about.chips.label')}</h3>
        <ul class="mt-8 flex flex-wrap gap-2.5" data-reveal style="--d:120ms">
          {
            chips.map((c) => (
              <li class="chip">
                <Icon name={c.icon} size={16} />
                {c.text}
              </li>
            ))
          }
        </ul>

        <h3 class="mt-12 font-display text-2xl font-bold" data-reveal>{t('about.offcode.title')}</h3>
        <ul class="mt-5 grid gap-4 sm:grid-cols-3">
          {
            offcode.map((o, i) => (
              <li class="brut p-4" data-reveal style={`--d:${i * 90}ms`}>
                <span class={`grid size-10 place-items-center rounded-lg border-2 border-line text-[#16120f] ${o.color}`}>
                  <Icon name={o.icon} size={20} />
                </span>
                <p class="mt-3 font-display text-lg leading-tight font-bold">{o.title}</p>
                <p class="mt-1.5 text-[0.9375rem] leading-snug text-muted">{o.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .photo-blob {
    border-radius: 58% 42% 46% 54% / 44% 52% 48% 56%;
    transition: border-radius 1.2s var(--ease-snappy);
  }
  .photo-blob:hover {
    border-radius: 44% 56% 54% 46% / 56% 44% 56% 44%;
  }
</style>
