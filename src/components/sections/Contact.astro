---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { site } from '@/config/site';
import { contactLimits as L } from '@/lib/contact';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const id = lang === 'es' ? 'contacto' : 'contact';

/* Mensajes que usa el script del formulario (traducidos). */
const messages = {
  name: t('contact.form.err.name'),
  email: t('contact.form.err.email'),
  message: t('contact.form.err.message'),
  long: t('contact.form.err.long'),
  sending: t('contact.form.sending'),
  submit: t('contact.form.submit'),
  success: t('contact.form.success'),
  error: t('contact.form.error'),
  rate: t('contact.form.rate'),
  copied: t('contact.copied'),
  copy: t('contact.copy'),
};

const field =
  'mt-2 block w-full rounded-xl border-2 border-line bg-bg px-4 py-3 text-base text-ink placeholder:text-muted/70 transition-[box-shadow,border-color] focus:shadow-[4px_4px_0_0_var(--ocean)] focus:outline-none aria-invalid:border-danger aria-invalid:shadow-[4px_4px_0_0_var(--danger)]';
---
<section id={id} class="section relative overflow-hidden" aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div>
        <SectionHeading id={`${id}-title`} kicker={t('contact.kicker')} title={t('contact.title')} intro={t('contact.intro')} />

        <p class="mt-10 font-mono text-sm text-muted" data-reveal>{t('contact.direct')}</p>
        <ul class="mt-4 space-y-3" data-reveal style="--d:80ms">
          <li class="brut flex flex-wrap items-center gap-3 p-3 pl-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg border-2 border-line bg-lava text-on-accent"><Icon name="mail" /></span>
            <a href={`mailto:${site.email}`} class="link min-w-0 flex-1 font-semibold break-all">{site.email}</a>
            <button type="button" class="btn btn-ghost !min-h-10 !px-3 !py-1.5 text-sm" data-copy={site.email}>
              <span data-copy-icon><Icon name="copy" size={16} /></span>
              <span data-copy-label>{t('contact.copy')}</span>
            </button>
          </li>
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="brut group flex items-center gap-3 p-3 pl-4 transition-transform hover:-translate-y-0.5">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg border-2 border-line bg-ocean text-[#16120f]"><Icon name="linkedin" /></span>
              <span class="flex-1 font-semibold">LinkedIn</span>
              <Icon name="arrowUpRight" class="mr-2 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
          <li>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="brut group flex items-center gap-3 p-3 pl-4 transition-transform hover:-translate-y-0.5">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg border-2 border-line bg-sulfur text-[#16120f]"><Icon name="github" /></span>
              <span class="flex-1 font-semibold">GitHub <span class="font-mono text-sm font-normal text-muted">@{site.githubUser}</span></span>
              <Icon name="arrowUpRight" class="mr-2 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
        </ul>
      </div>

      <div class="relative" data-reveal="scale">
        <form
          class="brut relative p-5 sm:p-8 md:p-9"
          method="post"
          action="/api/contact"
          novalidate
          data-contact-form
          data-astro-reload
          data-messages={JSON.stringify(messages)}
          data-email={site.email}
        >
          <input type="hidden" name="lang" value={lang} />
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="cf-name" class="font-semibold">{t('contact.form.name')}</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required minlength={L.name.min} maxlength={L.name.max} placeholder={t('contact.form.namePh')} class={field} aria-describedby="cf-name-err" />
              <p id="cf-name-err" class="mt-1.5 min-h-5 text-sm font-medium text-danger" data-error-for="name"></p>
            </div>
            <div>
              <label for="cf-email" class="font-semibold">{t('contact.form.email')}</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength={L.email.max} placeholder={t('contact.form.emailPh')} class={field} aria-describedby="cf-email-err" />
              <p id="cf-email-err" class="mt-1.5 min-h-5 text-sm font-medium text-danger" data-error-for="email"></p>
            </div>
          </div>
          <div class="mt-1">
            <label for="cf-company" class="font-semibold">
              {t('contact.form.company')} <span class="font-normal text-muted">({t('contact.form.optional')})</span>
            </label>
            <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength={L.company.max} placeholder={t('contact.form.companyPh')} class={field} aria-describedby="cf-company-err" />
            <p id="cf-company-err" class="mt-1.5 min-h-5 text-sm font-medium text-danger" data-error-for="company"></p>
          </div>
          <div class="mt-1">
            <label for="cf-message" class="font-semibold">{t('contact.form.message')}</label>
            <textarea id="cf-message" name="message" rows="5" required minlength={L.message.min} maxlength={L.message.max} placeholder={t('contact.form.messagePh')} class={`${field} resize-y`} aria-describedby="cf-message-err"></textarea>
            <p id="cf-message-err" class="mt-1.5 min-h-5 text-sm font-medium text-danger" data-error-for="message"></p>
          </div>

          <!-- Honeypot anti-spam: oculto para personas -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="cf-website">{t('contact.form.honeypot')}</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-primary min-w-48" data-submit>
              <Icon name="send" size={18} />
              <span data-submit-label>{t('contact.form.submit')}</span>
            </button>
          </div>
          <div class="mt-5 empty:hidden" role="status" aria-live="polite" data-form-status></div>
        </form>
        <span class="pointer-events-none absolute -top-5 right-4 rotate-3 rounded-lg border-2 border-line bg-ocean px-3 py-1 font-mono text-xs font-semibold text-[#16120f] shadow-[3px_3px_0_0_var(--shadow)]" aria-hidden="true">
          ✉ {lang === 'es' ? 'directo a mi bandeja' : 'straight to my inbox'}
        </span>
      </div>
    </div>
  </div>
</section>
