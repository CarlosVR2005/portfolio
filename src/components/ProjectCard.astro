---
import type { Lang } from '@/i18n/ui';
import { useTranslations, projectPath } from '@/i18n/utils';
import type { Project } from '@/lib/projects';
import Icon from '@/components/ui/Icon.astro';
import ProjectMockup from '@/components/mockups/ProjectMockup.astro';
import StatusTag from '@/components/ui/StatusTag.astro';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}
const { project, lang, index } = Astro.props;
const p = project.data;
const t = useTranslations(lang);
const href = projectPath(lang, p.slug);
const filterCat = p.category === 'academic' ? 'team' : p.category;
---
<li
  class:list={['project-item', p.wide ? 'md:col-span-6' : p.featured ? 'md:col-span-3' : 'md:col-span-2']}
  data-category={filterCat}
  data-reveal
  style={`--d:${(index % 3) * 90}ms`}
>
  <div class="h-full" data-tilt>
  <article
    class:list={["project-card brut group relative flex h-full flex-col overflow-hidden transition-[transform,box-shadow] duration-300 ease-[var(--ease-snappy)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[9px_9px_0_0_var(--shadow)]", p.wide && "md:flex-row"]}
  >
    <div class:list={["relative overflow-hidden border-b-2 border-line", p.wide && "md:w-1/2 md:shrink-0 md:border-r-2 md:border-b-0"]}>
      <div class="transition-transform duration-500 ease-[var(--ease-snappy)] group-hover:scale-[1.03]" style={`view-transition-name: mock-${p.slug}`}>
        <ProjectMockup kind={p.mockup} lang={lang} />
      </div>
      <div class="absolute top-3 left-3 flex flex-wrap gap-2">
        <StatusTag status={p.status} lang={lang} />
        {
          p.privacy === 'private' && (
            <span class="tag !border-[#16120f] bg-[#16120f] font-semibold text-[#f3e9d6] dark:!border-[#f3e9d6] dark:bg-[#2a221d]">
              <Icon name="lock" size={12} />
              {t('projects.private')}
            </span>
          )
        }
      </div>
    </div>

    <div class="flex flex-1 flex-col p-5 md:p-6">
      <p class="font-mono text-xs text-muted">{p.year} · {t(`projects.filter.${p.category}` as any)}</p>
      <h3 class="mt-2 font-display text-[1.75rem] leading-none font-extrabold">
        <a href={href} class="card-link after:absolute after:inset-0 after:z-[1] after:content-[''] focus-visible:outline-none">
          {p.title}
        </a>
      </h3>
      <p class="mt-3 text-[1.0625rem] leading-snug">{p.hook}</p>
      <p class="mt-3 text-sm text-muted"><span class="font-semibold text-ink">{t('projects.role')}:</span> {p.role}</p>

      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('projects.stack')}>
        {p.stack.slice(0, p.featured || p.wide ? 6 : 4).map((s) => <li class="tag">{s}</li>)}
      </ul>

      <!-- La fila queda por encima del enlace que cubre la tarjeta; sus huecos dejan pasar el clic a la tarjeta -->
      <div class="pointer-events-none relative z-[2] mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-5 [&_a]:pointer-events-auto">
        <a
          href={href}
          tabindex="-1"
          aria-hidden="true"
          class="inline-flex items-center gap-1.5 font-semibold text-lava-ink transition-transform group-hover:translate-x-1"
        >
          {t('projects.more')}
          <Icon name="arrowRight" size={18} />
        </a>
        {
          p.links.repo && (
            <a href={p.links.repo} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1 text-sm font-medium">
              <Icon name="github" size={16} /> {t('projects.repo')}
              <span class="sr-only">({p.title})</span>
            </a>
          )
        }
        {
          p.links.demo && (
            <a href={p.links.demo} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1 text-sm font-medium">
              <Icon name="external" size={15} /> {t('projects.demo')}
              <span class="sr-only">({p.title})</span>
            </a>
          )
        }
      </div>
    </div>
    <span class:list={['absolute top-0 right-0 h-full w-1.5', p.accent === 'lava' ? 'bg-lava' : p.accent === 'ocean' ? 'bg-ocean' : 'bg-sulfur']} aria-hidden="true"></span>
  </article>
  </div>
</li>

<style>
  .project-card:has(.card-link:focus-visible) {
    outline: 3px solid var(--ocean);
    outline-offset: 4px;
  }
</style>
