---
import { render } from 'astro:content';
import type { Lang } from '@/i18n/ui';
import { useTranslations, projectPath, langPrefix } from '@/i18n/utils';
import type { Project } from '@/lib/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import ProjectMockup from '@/components/mockups/ProjectMockup.astro';

interface Props {
  project: Project;
  next: Project;
  lang: Lang;
}
const { project, next, lang } = Astro.props;
const p = project.data;
const t = useTranslations(lang);
const { Content } = await render(project);
const home = langPrefix(lang) || '/';
const backHref = `${home === '/' ? '/' : `${home}/`}#${lang === 'es' ? 'proyectos' : 'projects'}`;
const accent = p.accent === 'lava' ? 'bg-lava' : p.accent === 'ocean' ? 'bg-ocean' : 'bg-sulfur';
const hasLinks = p.links.repo || p.links.demo || (p.links.sites?.length ?? 0) > 0;
---
<BaseLayout lang={lang} title={p.title} description={p.hook}>
  <article class="pt-28 pb-20 md:pt-36">
    <div class="container-x">
      <a href={backHref} class="group inline-flex items-center gap-2 font-mono text-sm text-muted hover:text-ink">
        <Icon name="arrowLeft" size={16} class="transition-transform group-hover:-translate-x-1" />
        {t('detail.back')}
      </a>

      <header class="mt-8 grid items-end gap-10 lg:grid-cols-[1.1fr_1fr]">
        <div>
          <div class="hero-in flex flex-wrap gap-2" style="--i:0">
            <StatusTag status={p.status} lang={lang} />
            <span class="tag">{t(`projects.filter.${p.category}`)}</span>
            {
              p.privacy === 'private' && (
                <span class="tag !border-[#16120f] bg-[#16120f] font-semibold text-[#f3e9d6] dark:!border-[#f3e9d6] dark:bg-[#2a221d]">
                  <Icon name="lock" size={12} />
                  {t('projects.private')}
                </span>
              )
            }
          </div>
          <h1 class="hero-in mt-5 text-[clamp(2.75rem,9vw,6rem)] leading-[0.92] font-extrabold tracking-[-0.04em]" style="--i:1">
            {p.title}<span class="text-lava">.</span>
          </h1>
          <p class="hero-in mt-5 max-w-xl text-xl md:text-2xl md:leading-snug" style="--i:2">{p.hook}</p>
        </div>
        <div class="hero-in relative" style="--i:2">
          <div class="brut overflow-hidden" style={`view-transition-name: mock-${p.slug}`}>
            <ProjectMockup kind={p.mockup} lang={lang} />
          </div>
          <p class="mt-3 text-right font-mono text-xs text-muted">{t('projects.mockupNote')}</p>
        </div>
      </header>

      <dl class="hero-in mt-12 grid gap-px overflow-hidden rounded-2xl border-2 border-line bg-line sm:grid-cols-3" style="--i:3">
        <div class="bg-surface p-5">
          <dt class="font-mono text-xs text-muted">{t('projects.role')}</dt>
          <dd class="mt-1 font-display text-lg leading-tight font-bold">{p.role}</dd>
        </div>
        <div class="bg-surface p-5">
          <dt class="font-mono text-xs text-muted">{p.team ? t('detail.team') : t('detail.year')}</dt>
          <dd class="mt-1 font-display text-lg leading-tight font-bold">{p.team ?? p.year}</dd>
        </div>
        <div class="bg-surface p-5">
          <dt class="font-mono text-xs text-muted">{p.team ? t('detail.year') : t('projects.stack')}</dt>
          <dd class="mt-1 font-display text-lg leading-tight font-bold">{p.team ? p.year : p.stack.slice(0, 3).join(' · ')}</dd>
        </div>
      </dl>

      <div class="mt-16 grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
        <div class="space-y-14">
          <section aria-labelledby="d-highlights" data-reveal>
            <h2 id="d-highlights" class="sr-only">{p.title}</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {
                p.highlights.map((h, i) => (
                  <li class="brut flex gap-3 p-4">
                    <span class={`grid size-8 shrink-0 place-items-center rounded-lg border-2 border-line font-mono text-sm font-bold text-[#16120f] ${accent}`}>
                      {i + 1}
                    </span>
                    <span class="leading-snug">{h}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section aria-labelledby="d-problem" data-reveal>
            <p class="kicker">// 01</p>
            <h2 id="d-problem" class="mt-2 text-3xl font-extrabold md:text-4xl">{t('detail.problem')}</h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed">{p.problem}</p>
          </section>

          <section aria-labelledby="d-solution" data-reveal>
            <p class="kicker">// 02</p>
            <h2 id="d-solution" class="mt-2 text-3xl font-extrabold md:text-4xl">{t('detail.solution')}</h2>
            <ul class="mt-5 max-w-2xl space-y-3 text-lg">
              {
                p.solution.map((s) => (
                  <li class="flex gap-3">
                    <Icon name="check" size={22} class="mt-1 shrink-0 text-lava-ink" />
                    <span>{s}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section aria-labelledby="d-result" data-reveal>
            <p class="kicker">// 03</p>
            <h2 id="d-result" class="mt-2 text-3xl font-extrabold md:text-4xl">{t('detail.result')}</h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed">{p.result}</p>
          </section>

          <details class="brut group max-w-2xl p-0" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl p-5 font-display text-xl font-bold [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-2"><Icon name="code" class="text-ocean-ink" /> {t('detail.tech')}</span>
              <span class="grid size-8 place-items-center rounded-lg border-2 border-line transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="tech-body border-t-2 border-line px-5 pt-4 pb-6">
              <Content />
            </div>
          </details>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
          <div class="brut p-5" data-reveal>
            <h2 class="font-display text-lg font-bold">{t('projects.stack')}</h2>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {p.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>

          {
            hasLinks && (
              <div class="brut p-5" data-reveal>
                <h2 class="font-display text-lg font-bold">{t('detail.links')}</h2>
                <ul class="mt-3 space-y-2">
                  {p.links.repo && (
                    <li>
                      <a href={p.links.repo} target="_blank" rel="noopener noreferrer" class="btn btn-ghost w-full justify-between">
                        <span class="flex items-center gap-2"><Icon name="github" size={18} /> {t('projects.repo')}</span>
                        <Icon name="arrowUpRight" size={18} />
                      </a>
                    </li>
                  )}
                  {p.links.demo && (
                    <li>
                      <a href={p.links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full justify-between">
                        <span class="flex items-center gap-2"><Icon name="external" size={18} /> {t('projects.demo')}</span>
                        <Icon name="arrowUpRight" size={18} />
                      </a>
                    </li>
                  )}
                  {p.links.sites?.map((s) => (
                    <li>
                      <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost w-full justify-between">
                        <span class="flex items-center gap-2"><Icon name="globe" size={18} /> {s.label}</span>
                        <Icon name="arrowUpRight" size={18} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            p.privacy === 'private' && (
              <div class="brut-sm flex gap-3 bg-[#16120f] p-4 text-[#f3e9d6]" data-reveal>
                <Icon name="lock" size={20} class="mt-0.5 shrink-0 text-[#ffc53d]" />
                <p class="text-sm leading-snug">{t('detail.privacyNote')}</p>
              </div>
            )
          }
        </aside>
      </div>

      <a
        href={projectPath(lang, next.data.slug)}
        class="brut group mt-20 flex flex-wrap items-center justify-between gap-4 p-6 transition-transform hover:-translate-y-1 md:p-8"
        data-reveal
      >
        <span>
          <span class="font-mono text-sm text-muted">{t('detail.next')}</span>
          <span class="mt-1 block font-display text-3xl font-extrabold md:text-5xl">{next.data.title}</span>
        </span>
        <span class="grid size-14 place-items-center rounded-full border-2 border-line bg-lava text-on-accent transition-transform group-hover:translate-x-1 group-hover:-rotate-12">
          <Icon name="arrowRight" size={24} />
        </span>
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .tech-body :global(ul) {
    display: grid;
    gap: 0.6rem;
  }
  .tech-body :global(li) {
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.5;
  }
  .tech-body :global(li)::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--lava-ink);
  }
  .tech-body :global(strong) {
    font-weight: 700;
  }
  .hero-in {
    animation: d-up 0.8s var(--ease-snappy) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }
  @keyframes d-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>
