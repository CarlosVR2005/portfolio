---
import { icons, type IconName } from '@/lib/icons';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  stroke?: number;
}
const { name, size = 20, class: cls = '', label, stroke = 2 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
><path d={icons[name]} /></svg>
