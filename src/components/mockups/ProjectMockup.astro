---
/**
 * Ilustraciones de interfaz para cada proyecto.
 * IMPORTANTE: todos los nombres, cifras y datos son inventados (no hay datos reales de nadie).
 */
interface Props {
  kind: 'sprintpilot' | 'origen' | 'psicofactur' | 'musculo' | 'webs' | 'tfg';
  lang: 'es' | 'en';
  class?: string;
}
const { kind, lang, class: cls = '' } = Astro.props;
const es = lang === 'es';
const S = 'var(--surface)';
const S2 = 'var(--surface-2)';
const L = 'var(--line)';
const M = 'var(--muted)';
const LAVA = 'var(--lava)';
const OCEAN = 'var(--ocean)';
const SUL = '#ffc53d';
const DARK = '#16120f';
const mono = 'font-family: var(--font-mono)';
const disp = 'font-family: var(--font-display); font-weight: 800';
---
<svg viewBox="0 0 480 300" class={`block h-auto w-full ${cls}`} aria-hidden="true" focusable="false" role="presentation">
  <rect width="480" height="300" fill={S2} />
  {
    kind === 'sprintpilot' && (
      <g>
        <rect x="24" y="22" width="432" height="256" rx="14" fill={S} stroke={L} stroke-width="2.5" />
        <rect x="24" y="22" width="432" height="38" rx="14" fill={OCEAN} stroke={L} stroke-width="2.5" />
        <rect x="24" y="46" width="432" height="14" fill={OCEAN} />
        <line x1="24" y1="60" x2="456" y2="60" stroke={L} stroke-width="2.5" />
        <text x="44" y="47" style={disp} font-size="17" fill={DARK}>SprintPilot</text>
        <text x="350" y="46" style={mono} font-size="11" fill={DARK}>Sprint 3 ▸</text>
        {[
          { x: 40, label: 'Backlog', n: 4 },
          { x: 180, label: 'Sprint', n: 3 },
          { x: 320, label: es ? 'Hecho' : 'Done', n: 2 },
        ].map((c, ci) => (
          <g>
            <text x={c.x} y="84" style={mono} font-size="11" fill={M}>
              {c.label.toUpperCase()} · {c.n}
            </text>
            {Array.from({ length: c.n }).map((_, i) => (
              <g>
                <rect
                  x={c.x}
                  y={94 + i * 42}
                  width="120"
                  height="34"
                  rx="7"
                  fill={ci === 2 ? '#c9efd8' : i === 0 && ci === 1 ? SUL : '#fff8ea'}
                  stroke={L}
                  stroke-width="2"
                />
                <rect x={c.x + 10} y={104 + i * 42} width={70 - i * 12} height="6" rx="3" fill={DARK} opacity="0.75" />
                <rect x={c.x + 10} y={115 + i * 42} width={44 + i * 9} height="5" rx="2.5" fill={DARK} opacity="0.3" />
              </g>
            ))}
          </g>
        ))}
        <g>
          <rect x="300" y="196" width="146" height="64" rx="10" fill={LAVA} stroke={L} stroke-width="2.5" />
          <text x="312" y="218" style={mono} font-size="11" font-weight="600" fill={DARK}>
            ✦ {es ? 'Sugerencia' : 'Suggestion'}
          </text>
          <text x="312" y="236" style={mono} font-size="10.5" fill={DARK}>
            {es ? 'Divide esta historia' : 'Split this story'}
          </text>
          <text x="312" y="250" style={mono} font-size="10.5" fill={DARK}>
            {es ? 'en 2 más pequeñas' : 'into 2 smaller ones'}
          </text>
        </g>
      </g>
    )
  }
  {
    kind === 'origen' && (
      <g>
        <rect x="24" y="22" width="432" height="256" rx="14" fill={S} stroke={L} stroke-width="2.5" />
        <text x="44" y="56" style={disp} font-size="22" fill="var(--ink)">ORIGEN</text>
        <text x="136" y="56" style={mono} font-size="12" fill={LAVA}>LZT</text>
        <path d="M380 58 l18 -24 l9 10 l7 -8 l14 22 z" fill={LAVA} stroke={L} stroke-width="2" />
        <line x1="24" y1="72" x2="456" y2="72" stroke={L} stroke-width="2" />
        {[0, 1, 2].map((i) => (
          <g transform={`translate(${44 + i * 138} 88)`}>
            <rect width="118" height="126" rx="10" fill={i === 1 ? SUL : '#fff8ea'} stroke={L} stroke-width="2" />
            <path
              d="M38 30 l12 -8 c4 6 14 6 18 0 l12 8 l-6 12 l-6 -3 v44 h-30 v-44 l-6 3 z"
              transform="translate(0 6)"
              fill={i === 0 ? DARK : i === 1 ? '#fffbf2' : '#e8471c'}
              stroke={DARK}
              stroke-width="2"
              stroke-linejoin="round"
            />
            {i === 2 && (
              <g>
                <rect x="66" y="8" width="44" height="18" rx="9" fill={DARK} />
                <text x="73" y="21" style={mono} font-size="9.5" fill="#f3e9d6">
                  {es ? 'ÚLTIMAS' : 'LOW'}
                </text>
              </g>
            )}
          </g>
        ))}
        {[0, 1, 2].map((i) => (
          <g transform={`translate(${44 + i * 138} 224)`}>
            <rect width={70 - i * 10} height="7" rx="3.5" fill="var(--ink)" opacity="0.8" />
            <rect y="14" width="34" height="6" rx="3" fill={LAVA} />
          </g>
        ))}
        <g>
          <rect x="330" y="252" width="110" height="18" rx="6" fill={OCEAN} stroke={L} stroke-width="2" />
          <text x="345" y="265" style={mono} font-size="10" fill={DARK} font-weight="600">
            {es ? 'Pagar · Stripe' : 'Pay · Stripe'}
          </text>
        </g>
      </g>
    )
  }
  {
    kind === 'psicofactur' && (
      <g>
        <rect x="24" y="22" width="432" height="256" rx="14" fill={S} stroke={L} stroke-width="2.5" />
        <rect x="24" y="22" width="108" height="256" rx="14" fill="#16120f" />
        <rect x="118" y="22" width="14" height="256" fill="#16120f" />
        <text x="40" y="52" style={disp} font-size="14" fill="#f3e9d6">Psicofactur</text>
        {[es ? 'Agenda' : 'Calendar', es ? 'Pacientes' : 'Patients', es ? 'Facturas' : 'Invoices'].map((n, i) => (
          <g>
            <rect x="36" y={72 + i * 30} width="84" height="22" rx="6" fill={i === 0 ? '#4fc3e0' : 'transparent'} />
            <text x="46" y={87 + i * 30} style={mono} font-size="10.5" fill={i === 0 ? DARK : '#f3e9d6'}>
              {n}
            </text>
          </g>
        ))}
        {['L', 'M', 'X', 'J', 'V'].map((d, i) => (
          <text x={160 + i * 58} y="50" style={mono} font-size="11" fill={M}>
            {es ? d : ['M', 'T', 'W', 'T', 'F'][i]}
          </text>
        ))}
        {[0, 1, 2, 3].map((r) => (
          <line x1="148" y1={64 + r * 40} x2="440" y2={64 + r * 40} stroke={L} stroke-opacity="0.15" stroke-width="1.5" />
        ))}
        {[
          [0, 0, OCEAN, es ? 'Paciente A' : 'Patient A', '✓'],
          [1, 1, SUL, es ? 'Pareja B' : 'Couple B', '?'],
          [2, 0, LAVA, 'Online C', '✓'],
          [3, 2, OCEAN, es ? 'Paciente D' : 'Patient D', '✓'],
          [4, 1, SUL, es ? 'Paciente E' : 'Patient E', '?'],
          [1, 3, OCEAN, es ? 'Paciente F' : 'Patient F', '✓'],
        ].map(([d, r, c, n, s]) => (
          <g>
            <rect x={152 + (d as number) * 58} y={70 + (r as number) * 40} width="52" height="32" rx="6" fill={c as string} stroke={L} stroke-width="1.8" />
            <text x={157 + (d as number) * 58} y={84 + (r as number) * 40} style={mono} font-size="7.5" fill={DARK}>
              {n}
            </text>
            <text x={157 + (d as number) * 58} y={96 + (r as number) * 40} style={mono} font-size="8" font-weight="700" fill={DARK}>
              {s}
            </text>
          </g>
        ))}
        <g>
          <rect x="148" y="232" width="292" height="32" rx="8" fill="#fff8ea" stroke={L} stroke-width="2" />
          <text x="160" y="252" style={mono} font-size="10.5" fill={DARK}>
            {es ? 'Factura 2026-0001 · Veri*Factu' : 'Invoice 2026-0001 · Veri*Factu'}
          </text>
          <rect x="370" y="240" width="60" height="16" rx="8" fill="#c9efd8" stroke={DARK} stroke-width="1.5" />
          <text x="380" y="252" style={mono} font-size="9" fill={DARK}>
            {es ? 'Pagada' : 'Paid'}
          </text>
        </g>
      </g>
    )
  }
  {
    kind === 'musculo' && (
      <g>
        <rect x="24" y="22" width="432" height="256" rx="14" fill={S} stroke={L} stroke-width="2.5" />
        <rect x="24" y="22" width="432" height="34" rx="14" fill="#1a7a43" stroke={L} stroke-width="2.5" />
        <rect x="24" y="42" width="432" height="14" fill="#1a7a43" />
        <line x1="24" y1="56" x2="456" y2="56" stroke={L} stroke-width="2.5" />
        <text x="42" y="44" style={mono} font-size="12" font-weight="600" fill="#fffbf2">
          {es ? 'Seguimiento · Cliente 01' : 'Tracking · Client 01'}
        </text>
        {[0, 1, 2, 3, 4].map((r) => (
          <g>
            {[0, 1, 2].map((c) => (
              <rect
                x={40 + c * 46}
                y={72 + r * 24}
                width="44"
                height="22"
                fill={r === 0 ? S2 : '#fff8ea'}
                stroke={L}
                stroke-opacity="0.35"
                stroke-width="1.2"
              />
            ))}
            {r === 0 ? (
              <text x="46" y="87" style={mono} font-size="9" fill="var(--ink)">
                {es ? 'Sem' : 'Wk'}
              </text>
            ) : (
              <g>
                <text x="46" y={87 + r * 24} style={mono} font-size="9" fill={DARK}>
                  {r}
                </text>
                <rect x={92} y={80 + r * 24} width={20 + r * 3} height="5" rx="2.5" fill={DARK} opacity="0.45" />
                <rect x={138} y={80 + r * 24} width={14 + r * 4} height="5" rx="2.5" fill={DARK} opacity="0.45" />
              </g>
            )}
          </g>
        ))}
        <g>
          <rect x="196" y="72" width="244" height="186" rx="10" fill="#fff8ea" stroke={L} stroke-width="2" />
          <text x="210" y="92" style={mono} font-size="10" fill={DARK}>
            {es ? 'Progresión de cargas' : 'Load progression'}
          </text>
          {[0, 1, 2, 3].map((i) => (
            <line x1="214" y1={118 + i * 34} x2="426" y2={118 + i * 34} stroke={DARK} stroke-opacity="0.12" stroke-width="1.5" />
          ))}
          <polyline
            points="216,226 252,214 288,206 324,182 360,170 396,148 424,132"
            fill="none"
            stroke="#e8471c"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mock-line"
          />
          <polyline
            points="216,236 252,232 288,226 324,222 360,212 396,206 424,198"
            fill="none"
            stroke="#0e6f8c"
            stroke-width="3"
            stroke-dasharray="6 6"
            stroke-linecap="round"
          />
          {[
            [216, 226],
            [288, 206],
            [360, 170],
            [424, 132],
          ].map(([x, y]) => (
            <circle cx={x} cy={y} r="5" fill="#ffc53d" stroke={DARK} stroke-width="2" />
          ))}
        </g>
        <rect x="40" y="200" width="136" height="58" rx="10" fill={SUL} stroke={L} stroke-width="2" />
        <text x="52" y="222" style={mono} font-size="9.5" fill={DARK}>
          {es ? 'Datos de ejemplo' : 'Sample data'}
        </text>
        <text x="52" y="244" style={disp} font-size="18" fill={DARK}>
          {es ? '+ progreso' : '+ progress'}
        </text>
      </g>
    )
  }
  {
    kind === 'webs' && (
      <g>
        <g transform="translate(28 34) rotate(-3 150 110)">
          <rect width="270" height="190" rx="12" fill={S} stroke={L} stroke-width="2.5" />
          <rect width="270" height="26" rx="12" fill={S2} stroke={L} stroke-width="2.5" />
          <rect y="14" width="270" height="12" fill={S2} />
          <line x1="0" y1="26" x2="270" y2="26" stroke={L} stroke-width="2.5" />
          <circle cx="16" cy="13" r="4" fill="#e8471c" />
          <circle cx="30" cy="13" r="4" fill="#ffc53d" />
          <circle cx="44" cy="13" r="4" fill="#4fc3e0" />
          <rect x="14" y="40" width="242" height="88" rx="8" fill="#4fc3e0" stroke={L} stroke-width="2" />
          <path d="M14 104 q20 -10 40 0 t40 0 t40 0 t40 0 t40 0 t42 0 v24 h-242z" fill="#0e6f8c" />
          <text x="28" y="72" style={disp} font-size="20" fill={DARK}>
            {es ? 'Club de natación' : 'Swimming club'}
          </text>
          <rect x="14" y="140" width="110" height="9" rx="4.5" fill="var(--ink)" opacity="0.7" />
          <rect x="14" y="156" width="160" height="7" rx="3.5" fill="var(--ink)" opacity="0.3" />
          <rect x="190" y="146" width="66" height="26" rx="8" fill="#e8471c" stroke={L} stroke-width="2" />
        </g>
        <g transform="translate(206 92) rotate(4 120 90)">
          <rect width="250" height="176" rx="12" fill={S} stroke={L} stroke-width="2.5" />
          <rect width="250" height="26" rx="12" fill={S2} stroke={L} stroke-width="2.5" />
          <rect y="14" width="250" height="12" fill={S2} />
          <line x1="0" y1="26" x2="250" y2="26" stroke={L} stroke-width="2.5" />
          <circle cx="16" cy="13" r="4" fill="#e8471c" />
          <circle cx="30" cy="13" r="4" fill="#ffc53d" />
          <circle cx="44" cy="13" r="4" fill="#4fc3e0" />
          <circle cx="190" cy="92" r="40" fill="#c9efd8" stroke={L} stroke-width="2" />
          <path d="M190 70 c-14 10 -14 34 0 44 c14 -10 14 -34 0 -44z M190 76 v34" fill="#1a7a43" stroke={DARK} stroke-width="2" />
          <text x="18" y="62" style={disp} font-size="17" fill="var(--ink)">
            {es ? 'Psicología' : 'Psychology'}
          </text>
          <text x="18" y="82" style={mono} font-size="10" fill={M}>
            Arrecife · Lanzarote
          </text>
          <rect x="18" y="100" width="110" height="7" rx="3.5" fill="var(--ink)" opacity="0.3" />
          <rect x="18" y="114" width="90" height="7" rx="3.5" fill="var(--ink)" opacity="0.3" />
          <rect x="18" y="136" width="80" height="24" rx="8" fill="#ffc53d" stroke={L} stroke-width="2" />
        </g>
      </g>
    )
  }
  {
    kind === 'tfg' && (
      <g>
        <rect x="24" y="22" width="432" height="256" rx="14" fill="#16120f" stroke={L} stroke-width="2.5" />
        {[
          [120, 90, 200, 150],
          [200, 150, 300, 110],
          [300, 110, 380, 170],
          [200, 150, 240, 230],
          [240, 230, 340, 220],
          [340, 220, 380, 170],
          [120, 90, 90, 190],
          [90, 190, 240, 230],
          [300, 110, 330, 60],
        ].map(([a, b, c, d]) => (
          <line x1={a} y1={b} x2={c} y2={d} stroke="#4fc3e0" stroke-opacity="0.6" stroke-width="2" />
        ))}
        {[
          [120, 90, 10, '#ffc53d'],
          [200, 150, 16, '#ff6a3d'],
          [300, 110, 12, '#4fc3e0'],
          [380, 170, 9, '#ffc53d'],
          [240, 230, 11, '#4fc3e0'],
          [340, 220, 8, '#ff6a3d'],
          [90, 190, 7, '#4fc3e0'],
          [330, 60, 6, '#ffc53d'],
        ].map(([x, y, r, c]) => (
          <circle cx={x} cy={y} r={r} fill={c as string} stroke="#f3e9d6" stroke-width="2" />
        ))}
        <text x="44" y="262" style={mono} font-size="11" fill="#f3e9d6">
          ~85.000 DAOs · Ethereum
        </text>
      </g>
    )
  }
</svg>
