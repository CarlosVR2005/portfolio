---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '@/config/site';
import { type Lang } from '@/i18n/ui';
import { useTranslations, alternatePath } from '@/i18n/utils';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import LangSuggest from '@/components/LangSuggest.astro';
import Cursor from '@/components/ui/Cursor.astro';
// Fuentes del primer pantallazo: se precargan para que el titular no cambie de fuente tarde
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import textFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  /** true en la home: los enlaces del menú son anclas locales */
  home?: boolean;
}

const { lang, title, description, ogImage, home = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${site.shortName}` : t('meta.title');
const pageDesc = description ?? t('meta.description');
const siteUrl = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
// Mismo formato que las URLs del build (con barra final) para que canonical y hreflang coincidan
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const altEs = new URL(slash(alternatePath(Astro.url.pathname, 'es')), siteUrl).href;
const altEn = new URL(slash(alternatePath(Astro.url.pathname, 'en')), siteUrl).href;
const og = new URL(ogImage ?? `/og/${lang}.png`, siteUrl).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: lang === 'es' ? 'Estudiante de Ingeniería de Software' : 'Software Engineering student',
  email: `mailto:${site.email}`,
  url: siteUrl.href,
  image: new URL('/img/carlos.jpg', siteUrl).href,
  sameAs: [site.github, site.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Complutense de Madrid' },
  knowsLanguage: ['es', 'en'],
};
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />

    <meta name="theme-color" content="#f3e9d6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14100d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_GB' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- Tema antes del primer pintado: sin parpadeo -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        d.dataset.theme = theme;
        document.addEventListener('astro:after-swap', function () {
          var s = null;
          try { s = localStorage.getItem('theme'); } catch (e) {}
          document.documentElement.dataset.theme = s || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.add('js');
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-[100] btn btn-primary"
      >{t('skip')}</a
    >
    <Nav lang={lang} home={home} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <LangSuggest lang={lang} />
    <Cursor />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
